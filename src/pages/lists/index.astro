---
import SplitScreenLayout from "../../layouts/SplitScreenLayout.astro";
import LinkButtonDiv from "../../components/LinkButtonDiv.astro";
---

<SplitScreenLayout title="Elliot's Lists">
  <div class="leftContainer">
    <h1>Lists</h1>
    <p>
      Come check out my <a href="/lists/master-watchlist" id="watchlist"
        >master watchlist</a
      >!
    </p>
    <div class="listDivider">
      <h3>By Difficulty</h3>
      <ul>
        <li><a href='/lists/difficulty/high-art'>The Inaccessible and Provocative: High Art Movies</a></li>
        <li><a href='/lists/difficulty/medium-art'>Digging Deeper: Medium Art Movies</a> <span class="newText">New</span></li>
        <li><a href='/lists/difficulty/beginning-art'>Beginning Anew: Beginner's Guide to Arthouse</a> <span class="newText">New</span></li>
      </ul>
    </div>
    <div class="listDivider">
      <h3>Miscellaneous</h3>
      <ul>
        <li>
          <a href="/lists/misc/movies-i-need-to-revisit"
            >Movies I Need to Revisit</a
          >
          <span class="newText">New</span>
        </li>
        <li>
          <a href='/lists/misc/short-films'>The Short Film Omnibus</a> <span class="newText">New</span>
        </li>
      </ul>
    </div>
  </div>
  <div class="rightContainer">
    <p>
      These are the different lists I'm creating. These will mainly be
      compilations of movies that fit a certain theme, like the filmmaking
      movement they're associated with or the time period. Sometimes, however,
      it may be hyperfocused compilations pointing to specific aspects of film. 
      Please note that I may not have seen all of the movies on this list, 
      it is merely used to categorize films I know about or have seen. I write
      descriptions for the movies I have not seen based on general synopsis.
    </p>
    <!-- <LinkButtonDiv /> -->
  </div>
</SplitScreenLayout>

<style>
  a {
    text-decoration: none;
    color: white;
  }

  li {
    font-size: 1.15rem;
  }

  .leftContainer {
    width: 70%;
    font-size: 1rem;
  }

  .rightContainer {
    width: 30%;
    padding-top: 4rem;
    margin-bottom: auto;
  }

  .listDivider {
    width: 100%;
  }

  .newText {
    font-size: 0.65rem;
    color: red;
  }

  #watchlist {
    color: #ff9b51;
    transition: color 0.25s ease-in;
  }

  #watchlist:hover {
    color: #f7b980;
  }

  @media screen and (max-width: 860px) {
    li {
      line-height: 1.4rem;
    }

    .leftContainer {
      max-width: 90%;
    }

    .rightContainer {
      max-width: 76%;
      padding-top: 0;
    }
  }
</style>
