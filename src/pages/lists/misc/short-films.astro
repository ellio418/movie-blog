---
import { Image } from "astro:assets"

import GenLayout from "../../../layouts/GenLayout.astro";
import { shortFilmList } from "../../../data/lists/short-films";
---

<GenLayout title="The Short Film Omnibus">
  <div class="genContainer">
    <div class="section">
      <h1>The Short Film Omnibus</h1>
      <p>
        Short films are an essential part of movie viewing. Films like <i
          >Meshes of the Afternoon</i
        > and <i>Un Chien Andalou</i> are examples of revolutionary short films, defining
        the movie landscape through unseen film technique and experimentation. All
        movies under 20 minutes will be listed below.
      </p>
    </div>
    <div class="listGrid">
      {
        Object.entries(shortFilmList)
          .sort(([, a], [, b]) => a.movieName.localeCompare(b.movieName))
          .map(([key, value]) => (
            <div class="movieCard">
              <div class="title">
                <h2>{value.movieName}</h2>
                {value.translatedName == "" ? (
                  <span />
                ) : (
                  <h3 class="translatedName">{value.translatedName}</h3>
                )}
              </div>
              {value.image == "" ? (
                <span />
              ) : (
                <Image src={value.image} width="184" height="115" alt="" />
              )}
              <div class='info'>
                <h3>{value.director}</h3>
                <p id="movieInfo">
                  {value.year}, {value.country}, {value.runtime}
                </p>
              </div>
              <p>{value.description}</p>
            </div>
          ))
      }
    </div>
  </div>
</GenLayout>

<style>
  img {
    border-radius: 10px;
  }

  .genContainer {
    width: 60%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .listGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(max(195px, 50%), 2fr));
    background-color: #F4F5F0;
    color: black;
    border-radius: 15px 15px 15px 15px;
    padding-top: 2%;
    padding-bottom: 2%;
  }

  .movieCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 3% 3% 3% 3%;
    text-align: center;
  }

  .title {
    margin-bottom: 1rem;
  }

  .title * {
    margin: 0;
  }

  .info {
    margin-top: 1rem;
  }

  .info * {
    margin: 0;
  }

  .section {
    width: 100%;
  }

  .translatedName {
    color: #556B2F;
  }

  #movieInfo {
    font-style: italic;
  }
</style>
