---
import { Image } from "astro:assets";

import GenLayout from "../../../layouts/GenLayout.astro";
import { mediumArtList } from "../../../data/lists/medium-art";
---

<GenLayout title="Digging Deeper: Medium Art Movies">
  <div class="genContainer">
    <div class="section">
      <h1>Digging Deeper: Medium Art Movies</h1>
      <p>
        Once you become familiar with some of the most famous arthouse works like <i>The 400 Blows</i> or <i>Breathless</i>, these movies
        lie underneath the surface. There are lots of films that fall within this category, where art triumphs over entertainment.
      </p>
    </div>
    <div class="listGrid">
      {
        Object.entries(mediumArtList)
          .sort(([, a], [, b]) => a.movieName.localeCompare(b.movieName))
          .map(([key, value]) => (
            <div class="movieCard">
              <div class="title">
                <h2>{value.movieName}</h2>
                {value.translatedName == "" ? (
                  <span />
                ) : (
                  <h3 class="translatedName">{value.translatedName}</h3>
                )}
              </div>
              {value.image == "" ? (
                <span />
              ) : (
                <Image src={value.image} width="184" height="115" alt="" />
              )}
              <div class='info'>
                <h3>{value.director}</h3>
                <p id="movieInfo">
                  {value.year}, {value.country}, {value.runtime}
                </p>
                <p><i>{value.genres.sort((a, b) => a.localeCompare(b))
                .map((genre) => genre).join(", ")}</i></p>
              </div>
              {/* <p>{value.description}</p> */}
            </div>
          ))
      }
    </div>
  </div>
</GenLayout>

<style>
  img {
    border-radius: 10px;
  }

  .genContainer {
    width: 60%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .listGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(max(195px, 50%), 2fr));
    background-color: #F4F5F0;
    color: black;
    border-radius: 15px 15px 15px 15px;
  }

  .movieCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 7% 3% 7% 3%;
    text-align: center;
  }

  .title {
    margin-bottom: 1rem;
  }

  .title * {
    margin: 0;
  }

  .info {
    margin-top: 1rem;
  }

  .info * {
    margin: 0;
  }

  .section {
    width: 100%;
  }

  .translatedName {
    color: #556B2F;
  }

  #movieInfo {
    font-style: italic;
  }
</style>
