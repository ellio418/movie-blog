---
import { Image } from "astro:assets";

import GenLayout from "../../../layouts/GenLayout.astro";
import { beginningArtList } from "../../../data/lists/beginning-art";
---

<GenLayout title="Starting Anew: Beginner's Guide to Arthouse">
  <div class="genContainer">
    <div class="section">
      <h1>Beginning Anew: Beginner's Guide to Arthouse</h1>
      <p>
        This is a resource for those wanting more out of their movies than just generic Netflix movies or dull theatrical releases. This
        list will likely be the most comprehensive, covering important films from film movements of the past.
      </p>
    </div>
    <div class="listGrid">
      {
        Object.entries(beginningArtList)
          .sort(([, a], [, b]) => a.movieName.localeCompare(b.movieName))
          .map(([key, value]) => (
            <div class="movieCard">
              <div class="title">
                <h2>{value.movieName}</h2>
                {value.translatedName == "" ? (
                  <span />
                ) : (
                  <h3 class="translatedName">{value.translatedName}</h3>
                )}
              </div>
              {value.image == "" ? (
                <span />
              ) : (
                <Image src={value.image} width="184" height="115" alt="" />
              )}
              <div class='info'>
                <h3>{value.director}</h3>
                <p id="movieInfo">
                  {value.year}, {value.country}, {value.runtime}
                </p>
                <p><i>{value.genres.sort((a, b) => a.localeCompare(b))
                .map((genre) => genre).join(", ")}</i></p>
              </div>
              {/* <p>{value.description}</p> */}
            </div>
          ))
      }
    </div>
  </div>
</GenLayout>

<style>
  img {
    border-radius: 10px;
  }

  .genContainer {
    width: 60%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .listGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(max(195px, 50%), 2fr));
    background-color: #F4F5F0;
    color: black;
    border-radius: 15px 15px 15px 15px;
  }

  .movieCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 7% 3% 7% 3%;
    text-align: center;
  }

  .title {
    margin-bottom: 1rem;
  }

  .title * {
    margin: 0;
  }

  .info {
    margin-top: 1rem;
  }

  .info * {
    margin: 0;
  }

  .section {
    width: 100%;
  }

  .translatedName {
    color: #556B2F;
  }

  #movieInfo {
    font-style: italic;
  }
</style>
